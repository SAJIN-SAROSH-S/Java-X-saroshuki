class Main{
    public static void main(String[] args){
        boolean isprime=true;
        int num=6;
        if (num<=1){
           isprime=false;
        }else{
            for(int i=2;i<=num/2;i++){
                if(num %i==0){
                    isprime=false;
                }
            }
        }
        if(isprime){
            System.out.println("prime");
        }else{
            System.out.println("not prime");
        }
    }
    
}
